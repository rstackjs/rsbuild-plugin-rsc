{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Ignore peerDependencies updates",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    },
    {
      "description": "Group all non-major dependencies together",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "lockFileMaintenance"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group Rsbuild packages",
      "groupName": "Rsbuild packages",
      "matchPackageNames": [
        "/^@rsbuild//",
        "/^@rslib//"
      ]
    },
    {
      "description": "Group React packages",
      "groupName": "React packages",
      "matchPackageNames": [
        "/^react/",
        "/^@types/react/"
      ]
    },
    {
      "description": "Group Playwright packages",
      "groupName": "Playwright packages",
      "matchPackageNames": [
        "/^@playwright//",
        "/^playwright$/"
      ]
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "schedule": [
    "before 3am on Monday"
  ]
}
