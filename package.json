{
  "name": "rsbuild-plugin-rsc",
  "version": "0.1.1",
  "packageManager": "pnpm@11.5.2",
  "description": "React Server Components plugin for Rsbuild",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rsbuild-plugin-rsc.git"
  },
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-rsc#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-rsc/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "typecheck": "pnpm -r exec tsc --noEmit --pretty false",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "test": "cd ./e2e && pnpm test:all"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@rsbuild/core": "^2.0.12",
    "@rslib/core": "^0.22.0",
    "@rslint/core": "^0.6.1",
    "@rstest/core": "^0.10.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fs-extra": "^11.3.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "react-server-dom-rspack": "0.0.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "react-server-dom-rspack": "*"
  }
}
