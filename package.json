{
  "name": "rsbuild-plugin-rsc",
  "version": "0.1.1",
  "packageManager": "pnpm@11.27.0",
  "description": "React Server Components plugin for Rsbuild",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rsbuild-plugin-rsc.git"
  },
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-rsc#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-rsc/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "cd ./e2e && pnpm test:all",
    "typecheck": "pnpm -r exec tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.6",
    "@rstest/playwright": "^0.11.12",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fs-extra": "^11.4.0",
    "playwright": "^1.63.0",
    "react-server-dom-rspack": "0.1.0",
    "rstack": "^0.7.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "react-server-dom-rspack": "*"
  }
}
